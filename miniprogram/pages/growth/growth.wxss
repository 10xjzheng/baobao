.segments{display:flex;gap:10rpx}.segments button{flex:1;min-height:82rpx;border-radius:24rpx;color:#8a938e;background:#eef1ef;font-size:26rpx}.segments .active{color:#26332f;font-weight:700}.segments .weight{background:#e4f5ea}.segments .height{background:#fff4d8}.segments .head{background:#ffe8e5}.add-record-button{width:100%;margin:20rpx 0}.date-filter{display:flex;align-items:center;gap:16rpx;margin-bottom:20rpx}.date-filter picker{flex:1}.date-filter .date-picker{min-height:64rpx;display:flex;align-items:center;justify-content:center;border-radius:22rpx;color:#26332f;background:#f0f2f0;font-size:26rpx}.date-filter .date-sep{color:#8a938e;font-size:24rpx}.chart-card{padding:32rpx}.chart-head{display:flex;justify-content:space-between;align-items:flex-end}.latest{margin-top:7rpx;font-size:50rpx;font-weight:700}.latest .unit{font-size:24rpx}.chart{width:640rpx;height:420rpx;margin-top:20rpx}.delta{display:flex;justify-content:space-between;padding-top:24rpx;border-top:1rpx solid #e8ebe8;font-size:25rpx}.delta text:last-child{color:#3d8859;font-weight:700}.details{overflow:hidden}.detail{min-height:128rpx;display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:14rpx 20rpx 14rpx 26rpx;border-bottom:1rpx solid #e8ebe8;font-size:26rpx;box-sizing:border-box}.detail:last-child{border-bottom:0}.detail-content{min-width:0}.detail .muted{display:block;margin-top:5rpx;font-size:21rpx}.detail-end{display:flex;align-items:center;gap:16rpx;white-space:nowrap}.delete{display:flex;align-items:center;justify-content:center;min-width:88rpx;min-height:64rpx;padding:0 12rpx;border-radius:18rpx;color:#d95c55;background:#ffe8e5;font-size:21rpx;line-height:1}
