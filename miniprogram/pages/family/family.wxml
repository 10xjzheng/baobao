<view class="page"><view class="safe-top" style="height: {{statusBarHeight}}px"></view><view class="page-title"><text>家庭成员</text></view><view class="card members"><view wx:for="{{members}}" wx:key="id" class="member" data-id="{{item.id}}" data-role="{{item.role}}" data-nickname="{{item.nickname}}" bindtap="manageMember"><view class="avatar">{{item.initial}}</view><view class="member-info"><text>{{item.nickname}}</text><text wx:if="{{currentRole === 'admin' || item.id === currentMemberId}}" class="edit-hint">点击编辑成员</text></view><text class="role {{item.role}}">{{item.roleName}}{{(currentRole === 'admin' || item.id === currentMemberId) ? ' ›' : ''}}</text></view></view>
  <view class="section-title">邀请家人</view><view class="card invite"><view class="muted">邀请码 24 小时内有效，默认以“可编辑”身份加入。</view><button class="primary-button" bindtap="createInvite">生成邀请码</button><view wx:if="{{inviteCode}}" class="code">{{inviteCode}}</view><button wx:if="{{inviteCode}}" class="share-button" open-type="share">转发邀请卡片</button></view>
  <autumn-leaves></autumn-leaves>
  <view class="section-title">加入家庭</view><view class="card join"><input class="field-input" maxlength="12" placeholder="输入家庭邀请码" value="{{joinCode}}" bindinput="updateJoinCode"/><button class="primary-button" loading="{{loading}}" bindtap="joinFamily">加入</button></view>
</view>
