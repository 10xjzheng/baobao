.leaves-layer{position:fixed;top:0;right:0;bottom:0;left:0;z-index:0;overflow:hidden;pointer-events:none}.maple{position:absolute;top:-100rpx;width:48rpx;height:58rpx;opacity:0;animation-name:leaf-fall;animation-timing-function:linear;animation-iteration-count:infinite;will-change:transform}.leaf-body{display:block;width:48rpx;height:58rpx;transform-origin:center}
.leaf-0{left:7%;animation-duration:13s;animation-delay:-8s}.leaf-1{left:21%;animation-duration:17s;animation-delay:-3s}.leaf-1 .leaf-body{transform:scale(.72)}.leaf-2{left:36%;animation-duration:15s;animation-delay:-12s}.leaf-2 .leaf-body{transform:scale(.9)}.leaf-3{left:52%;animation-duration:19s;animation-delay:-6s}.leaf-3 .leaf-body{transform:scale(.62)}.leaf-4{left:66%;animation-duration:14s;animation-delay:-1s}.leaf-4 .leaf-body{transform:scale(.82)}.leaf-5{left:79%;animation-duration:18s;animation-delay:-10s}.leaf-5 .leaf-body{transform:scale(.68)}.leaf-6{left:90%;animation-duration:16s;animation-delay:-5s}.leaf-6 .leaf-body{transform:scale(.94)}.leaf-7{left:44%;animation-duration:21s;animation-delay:-15s}.leaf-7 .leaf-body{transform:scale(.56)}
@keyframes leaf-fall{0%{opacity:0;transform:translate3d(-18rpx,-12vh,0) rotate(0deg)}10%{opacity:.34}35%{transform:translate3d(34rpx,32vh,0) rotate(125deg)}65%{transform:translate3d(-28rpx,68vh,0) rotate(245deg)}90%{opacity:.28}100%{opacity:0;transform:translate3d(22rpx,112vh,0) rotate(380deg)}}
