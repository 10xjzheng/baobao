.segments{display:flex;gap:8rpx;padding:8rpx;border-radius:28rpx;background:#eef1ef}.segments button{flex:1;min-height:80rpx;border-radius:22rpx;color:#8a938e;background:transparent;font-size:26rpx}.segments .active{color:#26332f;background:#fff;font-weight:700;box-shadow:0 5rpx 16rpx rgba(48,67,58,.07)}.add-record-button{width:100%;margin-top:20rpx}.record-list{overflow:hidden}.record{min-height:132rpx;display:grid;grid-template-columns:90rpx 1fr auto;align-items:center;gap:16rpx;padding:12rpx 22rpx;border-bottom:1rpx solid #e8ebe8;box-sizing:border-box}.record:last-child{border-bottom:0}.time,.meta{color:#8a938e;font-size:22rpx}.title{display:block;font-size:28rpx;font-weight:650}.meta{display:block;margin-top:5rpx}.record-end{text-align:right}.value{display:block;font-size:28rpx;font-weight:700}.delete{display:inline-block;width:84rpx;min-height:48rpx;margin-top:7rpx;padding:0;border-radius:16rpx;color:#d95c55;background:#ffe8e5;font-size:21rpx;line-height:48rpx;text-align:center}.loading{padding:80rpx;text-align:center;color:#8a938e}
