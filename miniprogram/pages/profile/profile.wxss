.profile{display:flex;align-items:center;gap:24rpx;padding:28rpx}.avatar{width:100rpx;height:100rpx;flex:none;border:4rpx solid #fff;border-radius:32rpx;box-shadow:0 8rpx 24rpx rgba(150,104,112,.16);box-sizing:border-box}.member-avatar{display:flex;align-items:center;justify-content:center;background:#ffe8e5;font-weight:700}.baby-info{min-width:0}.name{display:block;margin-bottom:12rpx;font-size:34rpx;font-weight:700}.baby-meta{display:flex;align-items:center;gap:10rpx;font-size:24rpx;line-height:1.5}.baby-age{color:#4f836f}.meta-dot{color:#b9a6a3}.baby-gender{color:#a97823;font-weight:650}.menu{margin-top:24rpx;overflow:hidden}.menu button{width:100%;min-height:104rpx;display:flex;align-items:center;justify-content:space-between;padding:0 28rpx;border-bottom:1rpx solid #e8ebe8;background:#fff;font-size:28rpx;text-align:left}.menu button:last-child{border-bottom:0}.members{overflow:hidden}.member{min-height:104rpx;display:flex;align-items:center;gap:20rpx;padding:12rpx 26rpx;border-bottom:1rpx solid #e8ebe8}.member:last-child{border-bottom:0}.member-avatar{width:66rpx;height:66rpx;border-radius:22rpx}.role{margin-left:auto;padding:8rpx 16rpx;border-radius:999rpx;font-size:21rpx}.role.admin{color:#a54d48;background:#ffe8e5}.role.editor{color:#3d8859;background:#e4f5ea}.role.viewer{color:#8a938e;background:#f1f3f1}
