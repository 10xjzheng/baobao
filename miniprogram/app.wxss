page {
  color: #26332f;
  background-color: #fbfbfa;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
}
button { box-sizing: border-box; }
button::after { border: 0; }
.page { position: relative; z-index: 1; min-height: 100vh; padding: 0 32rpx 40rpx; box-sizing: border-box; }
.safe-top { width: 100%; }
.page-title { min-height: 96rpx; display: flex; align-items: center; justify-content: space-between; padding-right: 180rpx; font-size: 44rpx; font-weight: 700; }
.card { background: #fff; border: 1rpx solid #e8ebe8; border-radius: 32rpx; box-shadow: 0 12rpx 36rpx rgba(61, 93, 76, .06); }
.section-title { margin: 40rpx 0 20rpx; font-size: 30rpx; font-weight: 700; }
.muted { color: #8a938e; }
.primary-button { min-height: 96rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; color: #276940; background: #e4f5ea; font-size: 30rpx; font-weight: 700; }
.secondary-button { min-height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; color: #8a938e; background: #f1f3f1; font-size: 28rpx; }
.form-card { padding: 8rpx 28rpx 28rpx; }
.field { margin-top: 28rpx; }
.field-label { display: block; margin-bottom: 12rpx; font-size: 26rpx; font-weight: 650; }
.field-input { min-height: 88rpx; padding: 0 24rpx; border: 1rpx solid #e8ebe8; border-radius: 22rpx; background: #f9faf9; box-sizing: border-box; }
.empty { padding: 90rpx 40rpx; text-align: center; }
.empty-icon { width: 96rpx; height: 96rpx; display: flex; align-items: center; justify-content: center; margin: 0 auto 24rpx; border-radius: 32rpx; color: #3d8859; background: #e4f5ea; font-size: 44rpx; }
.empty-title { font-size: 30rpx; font-weight: 700; }
.empty-text { margin-top: 12rpx; color: #8a938e; font-size: 24rpx; line-height: 1.6; }
