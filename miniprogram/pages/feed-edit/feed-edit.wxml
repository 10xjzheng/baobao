<view class="page"><view class="safe-top" style="height: {{statusBarHeight}}px"></view><view class="page-title"><text>新增喂奶记录</text><button class="close" bindtap="goBack">×</button></view>
  <view class="card form-card"><view class="field"><text class="field-label">日期</text><picker mode="date" value="{{day}}" bindchange="updateField" data-field="day"><view class="field-input picker">{{day}}</view></picker></view><view class="field"><text class="field-label">时间</text><picker mode="time" value="{{time}}" bindchange="updateField" data-field="time"><view class="field-input picker">{{time}}</view></picker></view>
    <autumn-leaves></autumn-leaves>
    <view class="field"><text class="field-label">喂养方式</text><view class="choices"><button class="{{type === 'breast' ? 'active' : ''}}" data-type="breast" bindtap="setType">母乳</button><button class="{{type === 'formula' ? 'active' : ''}}" data-type="formula" bindtap="setType">奶粉</button><button class="{{type === 'solid' ? 'active' : ''}}" data-type="solid" bindtap="setType">辅食</button><button class="{{type === 'mixed' ? 'active' : ''}}" data-type="mixed" bindtap="setType">混合</button></view></view>
    <view wx:if="{{type !== 'breast'}}" class="field"><text class="field-label">{{type === 'solid' ? '食量' : '奶量'}}（ml）</text><input class="field-input" type="digit" value="{{amount}}" placeholder="{{type === 'mixed' ? '可留空' : ''}}" data-field="amount" bindinput="updateField"/></view><view wx:if="{{type === 'mixed'}}" class="field"><text class="field-label">辅食量（ml）</text><input class="field-input" type="digit" value="{{solidAmount}}" placeholder="可选" data-field="solidAmount" bindinput="updateField"/></view><view wx:if="{{type === 'breast' || type === 'mixed'}}" class="field"><text class="field-label">持续时间（分钟）</text><input class="field-input" type="number" value="{{duration}}" placeholder="{{type === 'mixed' ? '可留空' : ''}}" data-field="duration" bindinput="updateField"/></view><view class="field"><text class="field-label">备注</text><input class="field-input" maxlength="200" placeholder="可选" data-field="note" bindinput="updateField"/></view>
  </view><button class="primary-button save" loading="{{saving}}" bindtap="save">保存记录</button>
</view>
