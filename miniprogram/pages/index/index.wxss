.hero { position:relative; min-height: 350rpx; overflow:hidden; padding: 32rpx 190rpx 40rpx 34rpx; border-radius: 40rpx; background: #fff4d8; box-shadow: 0 16rpx 40rpx rgba(61,93,76,.08); box-sizing: border-box; }
.hero-girl { background:#ffe8e5; box-shadow:0 16rpx 40rpx rgba(217,92,85,.10) }.hero-boy { background:#e3f3f8; box-shadow:0 16rpx 40rpx rgba(83,139,163,.11) }.hero-neutral { background:#fff4d8 }
.traffic { display: flex; gap: 12rpx; margin-bottom: 18rpx; }.traffic view { width: 16rpx; height: 16rpx; border-radius: 50%; }.traffic view:nth-child(1){background:#ff5f57}.traffic view:nth-child(2){background:#ffbd2e}.traffic view:nth-child(3){background:#28c840}
.hero-avatar{position:relative;z-index:1;width:104rpx;height:104rpx;border:4rpx solid rgba(255,255,255,.94);border-radius:34rpx;box-shadow:0 10rpx 26rpx rgba(126,91,76,.16);box-sizing:border-box}
.hero-subtitle { position:relative; z-index:1; display:flex; align-items:center; gap:10rpx; margin-top:20rpx; font-size:25rpx; line-height:1.6; white-space:nowrap }.hero-name{max-width:150rpx;overflow:hidden;color:#b96575;text-overflow:ellipsis}.hero-boy .hero-name{color:#4d7d94}.hero-neutral .hero-name{color:#9b7331}.hero-dot{color:#b9a6a3}.hero-age{color:#4f836f}.hero-gender{color:#a97823;font-weight:650}
.quote { position:relative; z-index:1; width:460rpx; margin-top:24rpx; color:#725d62; font-size:26rpx; line-height:1.75 }.hero-boy .quote{color:#55717c}.hero-neutral .quote{color:#75654b}
.leaf-cluster{position:absolute;right:26rpx;bottom:20rpx;width:148rpx;height:126rpx;opacity:.46;pointer-events:none}.maple{position:absolute;width:62rpx;height:76rpx}.leaf-one{right:4rpx;bottom:4rpx;transform:rotate(12deg)}.leaf-two{left:2rpx;bottom:0;transform:scale(.72) rotate(-18deg)}.leaf-three{right:42rpx;top:-8rpx;transform:scale(.54) rotate(28deg)}
.summary { position: relative; overflow: hidden; padding: 32rpx; }.summary::after { content:""; position:absolute; width:210rpx; height:210rpx; right:-74rpx; top:-82rpx; border-radius:50%; background:rgba(228,245,234,.8); }.summary-head,.stats { position:relative; z-index:1; }.summary-head { display:flex; justify-content:flex-end; align-items:center; font-size:26rpx; font-weight:700; }.pill { padding:10rpx 18rpx; border-radius:999rpx; color:#946a18; background:#fff4d8; font-size:20rpx; font-weight:400; }
.stats { display:grid; grid-template-columns:1fr 1fr; gap:20rpx; margin-top:28rpx; }.stat { min-height:164rpx; padding:26rpx; border-radius:28rpx; box-sizing:border-box; }.stat.feed{background:#fff4d8}.stat.growth{background:#e4f5ea}.number { display:block; margin:6rpx 0; font-size:48rpx; font-weight:700; }.stat .muted { font-size:22rpx; }
.actions { display:grid; grid-template-columns:1fr 1fr; gap:20rpx; }.action { min-height:100rpx; border-radius:28rpx; font-size:28rpx; font-weight:700; }.action.feed{color:#946a18;background:#fff4d8}.action.growth{color:#3d8859;background:#e4f5ea}.plus { display:inline-flex; align-items:center; justify-content:center; width:44rpx; height:44rpx; margin-right:12rpx; border-radius:50%; background:rgba(255,255,255,.6); }
.list { overflow:hidden; }.record-row { min-height:116rpx; display:grid; grid-template-columns:90rpx 1fr auto; align-items:center; gap:16rpx; padding:12rpx 26rpx; border-bottom:1rpx solid #e8ebe8; box-sizing:border-box; }.record-row:last-child{border-bottom:0}.time,.record-meta{color:#8a938e;font-size:22rpx}.record-title{display:block;font-size:27rpx;font-weight:650}.record-meta{display:block;margin-top:5rpx}.record-value{font-size:27rpx;font-weight:700}
.skeleton { height:300rpx; background:linear-gradient(90deg,#edf0ee 25%,#f8f9f8 50%,#edf0ee 75%); background-size:200% 100%; animation:shine 1.1s infinite; }@keyframes shine{to{background-position:-200% 0}}
.onboarding{margin-top:28rpx;padding:54rpx 32rpx;text-align:center}.onboarding .primary-button{margin-top:28rpx}.onboarding .secondary-button{margin-top:14rpx}
