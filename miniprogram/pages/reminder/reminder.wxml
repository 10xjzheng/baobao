<view class="page"><view class="safe-top" style="height: {{statusBarHeight}}px"></view><view class="page-title"><text>喂奶提醒</text><button class="close" bindtap="goBack">×</button></view>
  <autumn-leaves/>
  <view wx:if="{{loading}}" class="card settings loading-settings"><view class="setting"><text>开启提醒</text><text class="dash">—</text></view><view class="setting"><text>默认间隔</text><text class="dash">—</text></view><view class="setting"><text>提前提醒</text><text class="dash">—</text></view><view class="setting"><text>安静时段开始</text><text class="dash">—</text></view><view class="setting"><text>安静时段结束</text><text class="dash">—</text></view></view>
  <view wx:else class="card settings"><view class="setting"><view><text>开启提醒</text><text class="hint">首版先提供小程序内提醒</text></view><switch color="#28C840" checked="{{enabled}}" bindchange="toggle"/></view><view class="setting"><view><text>默认间隔</text><text class="hint">距离上一次喂奶</text></view><input type="number" value="{{intervalMinutes}}" placeholder="—" data-field="intervalMinutes" bindinput="updateField"/> <text>分钟</text></view><view class="setting"><view><text>提前提醒</text><text class="hint">在目标时间前提示</text></view><input type="number" value="{{advanceMinutes}}" placeholder="—" data-field="advanceMinutes" bindinput="updateField"/> <text>分钟</text></view><view class="setting"><text>安静时段开始</text><picker mode="time" value="{{quietStart}}" data-field="quietStart" bindchange="updateField"><view class="picker">{{quietStart || '—'}} ›</view></picker></view><view class="setting"><text>安静时段结束</text><picker mode="time" value="{{quietEnd}}" data-field="quietEnd" bindchange="updateField"><view class="picker">{{quietEnd || '—'}} ›</view></picker></view></view><view class="notice">微信订阅消息需要用户主动同意，而且可能受平台次数和规则限制。当前版本不会发送真实外部通知，也不会产生通知费用。</view><button class="primary-button save" loading="{{saving}}" disabled="{{loading}}" bindtap="save">保存设置</button></view>
