.close{width:82rpx;height:82rpx;border-radius:26rpx;color:#8a938e;background:#f1f3f1;font-size:38rpx}.picker{display:flex;align-items:center}.choices{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.choices button{min-height:84rpx;border-radius:22rpx;color:#8a938e;background:#f0f2f0;font-size:24rpx}.choices .active{color:#26332f;font-weight:700}.choices .pink{background:#ffe8e5}.choices .green{background:#e4f5ea}.choices .yellow{background:#fff4d8}.save{margin-top:28rpx}
