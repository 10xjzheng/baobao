.members{overflow:hidden}.member{min-height:112rpx;display:flex;align-items:center;gap:20rpx;padding:12rpx 26rpx;border-bottom:1rpx solid #e8ebe8}.member:last-child{border-bottom:0}.avatar{width:66rpx;height:66rpx;display:flex;align-items:center;justify-content:center;border-radius:22rpx;background:#ffe8e5;font-weight:700}.member-info{min-width:0}.member-info text{display:block}.edit-hint{margin-top:5rpx;color:#9aa39e;font-size:20rpx}.role{margin-left:auto;padding:8rpx 16rpx;border-radius:999rpx;font-size:21rpx}.role.admin{color:#a54d48;background:#ffe8e5}.role.editor{color:#3d8859;background:#e4f5ea}.role.viewer{color:#8a938e;background:#f1f3f1}.invite,.join{padding:28rpx}.invite .primary-button{margin-top:24rpx}.code{margin-top:22rpx;padding:24rpx;border-radius:22rpx;background:#fff4d8;color:#946a18;text-align:center;font-size:42rpx;font-weight:700;letter-spacing:8rpx}.share-button{width:100%;min-height:88rpx;margin-top:14rpx;border-radius:24rpx;color:#3d8859;background:#e4f5ea;font-size:27rpx;font-weight:700}.join{display:grid;grid-template-columns:1fr 160rpx;gap:16rpx}.join .primary-button{min-height:88rpx}
