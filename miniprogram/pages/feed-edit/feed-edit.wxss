.close{width:82rpx;height:82rpx;border-radius:26rpx;color:#8a938e;background:#f1f3f1;font-size:38rpx}.picker{display:flex;align-items:center}.choices{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx}.choices button{min-height:70rpx;padding:0 10rpx;border:4rpx solid #e4e8e4;border-radius:24rpx;color:#8a938e;background:#f0f2f0;font-size:24rpx}.choices .active{color:#946a18;background:#fff4d8;border-color:#e8c36a;font-weight:700}.save{margin-top:28rpx}
