<view class="page">
  <autumn-leaves/>
  <view class="safe-top" style="height: {{statusBarHeight}}px"></view>
  <view class="hero {{baby.heroClass}}">
    <view class="traffic"><view></view><view></view><view></view></view>
    <view class="leaf-cluster" aria-hidden="true">
      <image class="maple leaf-one" src="/assets/maple-leaf.svg" mode="aspectFit"/>
      <image class="maple leaf-two" src="/assets/maple-leaf.svg" mode="aspectFit"/>
      <image class="maple leaf-three" src="/assets/maple-leaf.svg" mode="aspectFit"/>
    </view>
    <image class="hero-avatar" src="/assets/default-baby-avatar.svg" mode="aspectFill"/>
    <view class="hero-subtitle"><text class="hero-name">{{baby.name}}</text><text class="hero-dot">·</text><text class="hero-age">{{baby.ageText}}</text><text class="hero-dot">·</text><text class="hero-gender">{{baby.genderLabel}}</text></view>
    <view class="quote">{{quote}}</view>
  </view>
  <view wx:if="{{needsOnboarding}}" class="card onboarding"><view class="empty-icon">♡</view><view class="empty-title">开始建立宝宝的成长空间</view><view class="empty-text">你可以创建新家庭，也可以输入家人发来的邀请码。</view><button class="primary-button" bindtap="createFamily">创建家庭</button><button class="secondary-button" bindtap="joinFamily">使用邀请码加入</button></view>
  <block wx:else>
  <view class="section-title">今日概览</view>
  <view wx:if="{{loading}}" class="card skeleton"></view>
  <view wx:else class="card summary">
    <view class="summary-head"><text class="pill">下次提醒 {{nextReminder}}</text></view>
    <view class="stats">
      <view class="stat feed"><text class="number">{{feedCount}} 次</text><text class="muted">吃奶 · 共 {{feedAmount}} ml</text></view>
      <view class="stat growth"><text class="number">{{latestWeight}}</text><text class="muted">最近体重</text></view>
    </view>
  </view>
  <view class="section-title">快速记录</view>
  <view class="actions"><button class="action feed" bindtap="addFeed"><text class="plus">＋</text>记吃奶</button><button class="action growth" bindtap="addGrowth"><text class="plus">＋</text>记成长</button></view>
  <view class="section-title">今天的足迹</view>
  <view wx:if="{{timeline.length}}" class="card list">
    <view wx:for="{{timeline}}" wx:key="id" class="record-row"><text class="time">{{item.timeText}}</text><view><text class="record-title">{{item.typeName}}</text><text class="record-meta">{{item.recorderName}}记录</text></view><text class="record-value">{{item.valueText}}</text></view>
  </view>
  <view wx:else class="card empty"><view class="empty-icon">♡</view><view class="empty-title">今天还没有记录</view><view class="empty-text">添加第一条记录，开始收藏宝宝的日常。</view></view>
  </block>
</view>
